# ── Shared (used by BOTH desktop and web) ────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Shared secret for desktop→web internal API calls
INTERNAL_TOKEN=replace-with-32-byte-random-base64

# ── Desktop only ──────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=utter-recordings

# URL of the running Next.js web app (for POST /api/recordings/:id/finalize)
WEB_BASE_URL=http://localhost:3000

# ── Web only ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=utter

# iron-session cookie secret — must be 32+ random characters
SESSION_PASSWORD=replace-with-32-byte-random-string

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# R2 read access for the web side (signs GET urls for playback/share)
# Can reuse same R2 keys from above or use a separate read-only key
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=utter-recordings
