# ── Shared (used by BOTH desktop and web) ────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Shared secret for desktop→web internal API calls (POST /finalize)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTERNAL_TOKEN=replace-with-32-byte-random-base64

# ── Desktop only ──────────────────────────────────────────────────────────────
# Cloudflare R2 credentials for the desktop app (needs write access to upload recordings)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=utter-recordings

# URL of the running Next.js web app (where desktop POSTs /finalize after upload)
WEB_BASE_URL=http://localhost:3000

# ── Web only ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=utter

# iron-session cookie secret — must be 32+ random characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD=replace-with-32-character-hex-string

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 credentials for the web app (needs read access to sign GET URLs for playback/share)
# You can reuse the same keys as the desktop, or create a separate read-only API token in R2
WEB_R2_ACCOUNT_ID=
WEB_R2_ACCESS_KEY_ID=
WEB_R2_SECRET_ACCESS_KEY=
WEB_R2_BUCKET=utter-recordings
